  m_TableData:
  - m_Id: 46246866944
    m_Localized: "\u0416\u0438\u0434\u043A\u043E\u0441\u0442\u044C, \u043E\u0441\u043D\u043E\u0432\u0430
      \u0434\u043B\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430
      \u0437\u0435\u043B\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 58376794112
    m_Localized: "\u0416\u0430\u0440\u043A\u043E\u0435 \u043F\u043B\u0430\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 176777801728
    m_Localized: "\u041D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0432 \u0440\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 68581535744
    m_Localized: "\u0411\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 142900408320
    m_Localized: "\u0421\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043B\u0438\u043F\u043D\u0435\u0442
      \u043A \u0440\u0443\u043A\u0430\u043C, \u043D\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0432\u043B\u0430\u0436\u043D\u043E\u0435 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 84248279897718784
    m_Localized: "\u041D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E,
      \u0438\u043D\u0430\u0447\u0435 \u044D\u0442\u043E \u0431\u0443\u0434\u0435\u0442
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0435\u0441\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 84256034901573632
    m_Localized: "\u041E\u0441\u0442\u0440\u0435\u043D\u044C\u043A\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 104517013119811584
    m_Localized: "\u0417\u0435\u043B\u0451\u043D\u044B\u0435, \u043A\u0430\u043A
      \u0438 \u0440\u043E\u0434\u043D\u043E\u0435 \u0438\u043C \u0431\u043E\u043B\u043E\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 104517015720280064
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439
      \u0433\u0440\u0438\u0431."
    m_Metadata:
      m_Items: []
