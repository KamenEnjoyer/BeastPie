  m_TableData:
  - m_Id: 176777801728
    m_Localized: Nenauokit rujuje.
    m_Metadata:
      m_Items: []
  - m_Id: 68581535744
    m_Localized: ' Benaudis.'
    m_Metadata:
      m_Items: []
  - m_Id: 58376794112
    m_Localized: "Kar\u0161ta liepsna."
    m_Metadata:
      m_Items: []
  - m_Id: 46246866944
    m_Localized: "Skystis, kuris yra daugelio ap\u017Eav\u0173 g\u0117rim\u0173 pagrindas."
    m_Metadata:
      m_Items: []
  - m_Id: 142900408320
    m_Localized: "Visi\u0161kai nelimpa prie rank\u0173, bet palieka dr\u0117gnumo
      poj\u016Bt\u012F."
    m_Metadata:
      m_Items: []
  - m_Id: 84248279897718784
    m_Localized: Nenaudokit perdaug, nes tai bus neimanoma vaigyti!
    m_Metadata:
      m_Items: []
  - m_Id: 84256034901573632
    m_Localized: "A\u0161trokai!"
    m_Metadata:
      m_Items: []
